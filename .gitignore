# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# Secrets and API keys (never commit)
.env
.env.*
!.env.example
*.key
*.pem
secrets/
*api_key*
*apikey*

# Generated results (directory kept; outputs regenerated by the scripts)
results/*
!results/.gitkeep

# Manual chat-evaluation working folders (raw prompts/transcripts).
# To publish anonymized examples later, copy them to examples/manual/ and commit deliberately.
manual_prompts/
manual_responses/

# Scratch / temporary files
scratch/
tmp/
*.tmp
*.bak
*.swp

# OS / editor
.DS_Store
.idea/
.vscode/
